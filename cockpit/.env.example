# Copy to .env and fill in. Never commit .env.
COCKPIT_DATABASE_URL=sqlite:///./cockpit.db
COCKPIT_TZ=UTC
# fake = no API calls (default). claude = use the Claude API.
COCKPIT_LLM=fake
ANTHROPIC_API_KEY=
# Stop model calls for the day after this many tokens (0 = no cap).
COCKPIT_DAILY_TOKEN_CAP=50000
